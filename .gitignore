# Persistence-mechanism baseline
data/persistence.baseline.json

# Threat-intel cache
data/threat_intel_cache.json

# Forensic snapshots
data/forensics/

# Quarantined files (operator-only, may contain malware)
quarantine/

# Self-protect manifest (regenerated via --build-manifest)
data/manifest.json
data/integrity.manifest.json

# FIM baseline (per-host)
data/baseline.db
data/baseline.db-wal
data/baseline.db-shm

# Stray data files
data/*.tmp
data/*.bak

